# ==============================================================================
# VIRA (Voice Integrity and Real-Time Authentication) — Environment Configuration
# ==============================================================================
# Copy this file to .env or configure environment variables in your deployment platform.
# DO NOT commit production secrets to version control.

# ==========================================
# SERVER CONFIGURATION (vira-server)
# ==========================================
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Server Admin Connection (Required for database verification & dataset collection)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Real-Time Speech-to-Text Transcription Provider (Deepgram / Whisper)
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=YOUR_ACTUAL_KEY_HERE
# Optional alternative:
# TRANSCRIPTION_PROVIDER=whisper
# TRANSCRIPTION_API_KEY=YOUR_OPENAI_OR_WHISPER_KEY_HERE

# Model Path Overrides (Optional — defaults to server/models/*.onnx)
# VIRA_AASIST_MODEL_PATH=./server/models/aasist.onnx
# VIRA_ECAPA_MODEL_PATH=./server/models/ecapa.onnx

# ML Decision & Fusion Thresholds (Optional — default calibration values shown)
# VIRA_AASIST_SPOOF_THRESH=0.70
# VIRA_AASIST_LIVE_THRESH=0.55
# VIRA_ECAPA_MATCH_THRESH=0.92
# VIRA_ECAPA_MISMATCH_THRESH=0.82
# VIRA_ECAPA_UNCERTAIN_THRESH=0.82

# ==========================================
# CLIENT CONFIGURATION (vira-client)
# ==========================================
VITE_SERVER_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
